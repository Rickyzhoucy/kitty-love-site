APP_ENV=production
POSTGRES_DB=kitty_love_db
POSTGRES_USER=kitty
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

MINIO_ROOT_USER=kitty-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# 默认仅本机可访问；局域网直传时改为服务端局域网 IP，并限制防火墙来源。
MINIO_BIND_HOST=127.0.0.1
# 局域网设备上传时改成服务端可访问的主机名或域名，例如 192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
# 浏览器连 MinIO 用不用 https。生产上 Caddy 反代桶路径、站点是 https，
# 这里要设 true；本地开发浏览器直连 127.0.0.1:9000 明文，保持 false。
MINIO_PUBLIC_SECURE=false

# 中国大陆可直连的百炼 OpenAI 兼容 API；聊天模型必须同时支持视觉与 Function Calling。
CHAT_MODEL=qwen3.6-flash
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=

# 可替换的在线向量模型，当前数据库向量维度固定为 1024。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

SKILL_WORKER_TOKEN=replace-with-at-least-32-random-characters
# Skill 市场只由服务器访问。skills.sh v1 使用短期 Vercel OIDC Token；
# 也可在 Admin 的“系统配置 / Skill 目录”中加密保存。
SKILL_CATALOG_URL=https://skills.sh
SKILL_CATALOG_TOKEN=

# 单个 MCP Server 同步目录的硬上限，防止恶意分页或超大 Schema 拖垮 API。
MCP_MAX_TOOLS=200
MCP_MAX_CATALOG_BYTES=2097152

# ── 远端文档运行时（暂不启用）──────────────────────────────────────
#
# 当前 2C4G 生产机不要启动 Docling/Gotenberg，这三个值保持为空。留空时后端只走
# 明确标记为 builtin-degraded 的轻量解析，不会在本机加载 Docling/OCR 模型。
#
# 以后 Mac mini NAS 空出来后，在 NAS 上用 docker-compose.document.yml 启动，
# 再将下列 URL 改为 NAS 的 Tailscale/WireGuard 私网地址。禁止直接使用公网端口；
# DOCUMENT_PARSER_API_KEY 必须与 NAS 的 DOCLING_SERVE_API_KEY 相同。
#
# 示例：
# DOCUMENT_PARSER_URL=http://100.64.0.10:5001
# DOCUMENT_RENDERER_URL=http://100.64.0.10:3000
DOCUMENT_PARSER_URL=
DOCUMENT_PARSER_API_KEY=
DOCUMENT_RENDERER_URL=

# 模型的上下文预算（token）。对话历史用掉 CHAT_COMPACT_AT 这个比例时自动压缩
# （LangChain 的 SummarizationMiddleware），换模型时改这一个值即可。
CHAT_CONTEXT_TOKENS=256000
CHAT_COMPACT_AT=0.75
CHAT_COMPACT_KEEP_MESSAGES=20

# 联网搜索（可选）。不填 WEB_SEARCH_API_KEY 时 web_search 工具不会注册。
# 提供方：bocha（国内直连）/ tavily / brave
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=

# 恋爱地图（可选）。不填时 /map 页面显示「还没配地图」，其它功能不受影响。
# 在 https://lbs.amap.com 控制台创建 Key，**服务平台必须选「Web端(JS API)」**
# ——选成「Web服务」拿不到安全密钥，地图选点和搜索会失效。
#
# NEXT_PUBLIC_AMAP_KEY 是**构建期**变量（Dockerfile 的 ARG），改了要重建 web
# 镜像才生效；AMAP_SECURITY_JS_CODE 是运行时变量，重启容器即可。
# 安全密钥刻意不带 NEXT_PUBLIC_ 前缀：它只在服务端用（app/%5FAMapService 转发时
# 拼上去），带了前缀就会被打进前端包，等于公开。
NEXT_PUBLIC_AMAP_KEY=
AMAP_SECURITY_JS_CODE=

# 宠物工作区（沙箱内的持久草稿纸）
WORKSPACE_MAX_BYTES=67108864
WORKSPACE_RETENTION_DAYS=14
# 技能脚本的执行上限（秒）。调用方按「这个值 + 10 秒」设自己的 HTTP 超时，
# 所以两边必须是同一个数——只改一边会让脚本跑着跑着客户端先断开。
SKILL_SCRIPT_TIMEOUT=30

# ── Passkey（一键登录）─────────────────────────────────────────────
#
# **配错不会报错。** 表现是按指纹时弹窗一闪而过、什么都不发生，控制台也
# 未必说清楚——所以这两个必须跟着域名一起改，别只改一个。
#
# WEBAUTHN_RP_ID   要和浏览器地址栏里的域名逐字一致（或是它的父域），不带协议、
#                  不带端口。本地开发用 localhost。
# WEBAUTHN_ORIGINS 要带协议和非默认端口，多个用逗号分隔。
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# 时区。所有「今天」「深夜」按它算，不按容器时区算（容器跑在 UTC）。
SITE_TIMEZONE=Asia/Shanghai

# 上下文预算。换模型之后记得跟着调。
CHAT_CONTEXT_TOKENS=256000
CHAT_COMPACT_AT=0.75
CHAT_COMPACT_KEEP_MESSAGES=20

# 跨域来源，逗号分隔。同源部署（Caddy 反代）用不上；Tauri 桌面端要靠它。
CORS_ORIGINS=http://localhost:3000

# 数据库对宿主机暴露的端口。只为本机调试用，生产不必开。
POSTGRES_PORT=25433

# ── 部署相关（生产才用得上）───────────────────────────────────────
#
# 境内服务器走镜像站，否则 apt / pypi 会慢到构建超时。镜像站的可达性取决于
# 机器在哪（腾讯云内网那个域名出了腾讯云就解析不了），所以留空即走官方源。
# APT_MIRROR=mirrors.tencentyun.com
# PYPI_INDEX=http://mirrors.tencentyun.com/pypi/simple/
#
# 旧站遗留的上传目录，只读挂进 web 容器。数据库里存的是 /uploads/xxx.jpg
# 这种旧路径，不挂进来那些历史照片全是裂图。
# LEGACY_UPLOADS=/home/app/legacy-uploads
#
# 浏览器访问 MinIO 的地址与协议。**生产必须是浏览器够得着的域名**，
# 填 127.0.0.1 的话预签名 URL 会指向访客自己那台电脑，照片全裂。
# 桶路径由反向代理转发到 MinIO，Host 要透传（SigV4 把 host 算进签名）。
# MINIO_PUBLIC_ENDPOINT=love.example.com
# MINIO_PUBLIC_SECURE=true

# 前端与 API 同源时留空即可。
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_EVENT_BASE_URL=
