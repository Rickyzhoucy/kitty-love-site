APP_ENV=production
POSTGRES_DB=kitty_love_db
POSTGRES_USER=kitty
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

MINIO_ROOT_USER=kitty-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# 默认仅本机可访问；局域网直传时改为服务端局域网 IP，并限制防火墙来源。
MINIO_BIND_HOST=127.0.0.1
# 局域网设备上传时改成服务端可访问的主机名或域名，例如 192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000

# 中国大陆可直连的百炼 OpenAI 兼容 API；聊天模型必须同时支持视觉与 Function Calling。
CHAT_MODEL=qwen3.6-flash
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=

# 可替换的在线向量模型，当前数据库向量维度固定为 1024。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

SKILL_WORKER_TOKEN=replace-with-at-least-32-random-characters

# 模型的上下文预算（token）。对话历史用掉 CHAT_COMPACT_AT 这个比例时自动压缩
# （LangChain 的 SummarizationMiddleware），换模型时改这一个值即可。
CHAT_CONTEXT_TOKENS=256000
CHAT_COMPACT_AT=0.75
CHAT_COMPACT_KEEP_MESSAGES=20

# 联网搜索（可选）。不填 WEB_SEARCH_API_KEY 时 web_search 工具不会注册。
# 提供方：bocha（国内直连）/ tavily / brave
WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_API_KEY=

# 恋爱地图（可选）。不填时 /map 页面显示「还没配地图」，其它功能不受影响。
# 在 https://lbs.amap.com 控制台创建 Key，**服务平台必须选「Web端(JS API)」**
# ——选成「Web服务」拿不到安全密钥，地图选点和搜索会失效。
#
# NEXT_PUBLIC_AMAP_KEY 是**构建期**变量（Dockerfile 的 ARG），改了要重建 web
# 镜像才生效；AMAP_SECURITY_JS_CODE 是运行时变量，重启容器即可。
# 安全密钥刻意不带 NEXT_PUBLIC_ 前缀：它只在服务端用（app/%5FAMapService 转发时
# 拼上去），带了前缀就会被打进前端包，等于公开。
NEXT_PUBLIC_AMAP_KEY=
AMAP_SECURITY_JS_CODE=
