{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Kitty Love trusted server window and credential commands",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-save-device-token",
    "allow-load-device-token",
    "allow-delete-device-token"
  ]
}
