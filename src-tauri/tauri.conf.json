{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitty Love",
  "version": "0.1.0",
  "identifier": "love.kitty.companion",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["desktop"]
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
