# Mac mini NAS 文档节点配置。复制为 .env.document 后再启动；不要提交真实密钥。

# 至少 32 位强随机字符串。主站的 DOCUMENT_PARSER_API_KEY 必须与它相同。
DOCLING_SERVE_API_KEY=replace-with-at-least-32-random-characters

# 默认只监听 NAS 本机，最安全但远端主站访问不到。
# 准备接入时改为 NAS 的 Tailscale/WireGuard 地址；如果 macOS/Docker Desktop
# 无法绑定该虚拟地址，可用 0.0.0.0，但必须同时用系统防火墙和 VPN ACL 限制来源。
# 禁止把 5001/3000 通过路由器端口转发或公网安全组开放出去。
DOCUMENT_RUNTIME_BIND_HOST=127.0.0.1
DOCLING_PORT=5001
GOTENBERG_PORT=3000

# 默认按文档服务的独立资源预算设置；可根据 Mac mini 实际内存调整。
DOCLING_MEMORY_LIMIT=6g
DOCLING_CPU_LIMIT=4.0
GOTENBERG_MEMORY_LIMIT=1g
GOTENBERG_CPU_LIMIT=2.0
